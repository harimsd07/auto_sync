{
  "_kodela": {
    "schema_version": 1,
    "last_updated_cli_version": "1.2.1",
    "capture_mode": "watcher",
    "next_steps": [
      "★ Claude Code hooks (preferred) — kodela hook install --claude",
      "◆ Watcher (any AI tool)         — kodela watch --auto-annotate --detach",
      "◇ Manual                        — kodela add <file> -s <line> -e <line> -n \"...\""
    ],
    "docs_url": "https://kodela.dev/getting-started"
  },
  "hooks": {
    "line_threshold": 50,
    "minimum_summary_length": 10,
    "required_fields": [
      "note"
    ]
  },
  "ci": {
    "enforcement": "advisory",
    "thresholds": {
      "min_confidence_score": 0.8,
      "max_orphaned_pct": 10,
      "max_unresolved_critical_pct": 5
    }
  },
  "baseline": {
    "max_days_before_archive": 90,
    "ignore_patterns": [
      "node_modules/**",
      ".git/**",
      ".local/**",
      "dist/**",
      "build/**",
      "coverage/**",
      ".cache/**",
      ".next/**",
      ".nuxt/**",
      "*.map",
      "*.js.map",
      "pnpm-lock.yaml",
      "package-lock.json",
      "yarn.lock",
      "attached_assets/**"
    ]
  },
  "ai_detection": {
    "enabled": true,
    "min_lines_added": 100,
    "comment_patterns": [
      "AI-generated",
      "Generated by",
      "Co-authored-by: github-actions",
      "Copilot",
      "ChatGPT",
      "Claude",
      "Gemini"
    ],
    "insertion_speed_threshold_ms": 2000,
    "editor_insertion_min_lines": 10,
    "new_file_flag": true,
    "new_file_min_lines": 50
  },
  "security": {
    "sensitive_paths": [
      "auth/",
      "authentication/",
      "payments/",
      "billing/",
      "crypto/",
      "cryptography/",
      "security/",
      "secrets/",
      "credentials/",
      "tokens/"
    ]
  },
    "storage":{
      "mode": "central",
    "server": {
      "url": "https://kodela.app",
      "api_key_env": "KODELA_API_KEY"
    }
  },
  "hooksInstalled": true
}
