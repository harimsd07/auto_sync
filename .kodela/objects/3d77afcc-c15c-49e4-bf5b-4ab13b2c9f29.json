    "diff": "- \n+ <!DOCTYPE html>\n+ <html lang=\"en\" class=\"dark\">\n+ <head>\n+   <meta charset=\"UTF-8\" />\n+   <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n+   <title>Knowledge Grounded RAG AI Suite</title>\n+   <script src=\"https://cdn.tailwindcss.com\"></script>\n+   <script>\n+     tailwind.config = {\n+       darkMode: 'class',\n+       theme: {\n+         extend: {\n+           colors: {\n+             brand: {\n+               50: '#eef2ff',\n+               100: '#e0e7ff',\n+               500: '#6366f1',\n+               600: '#4f46e5',\n+               700: '#4338ca',\n+               900: '#312e81',\n+             },\n+             surface: {\n+               800: '#1e1e2e',\n+               900: '#11111b',\n+               950: '#0b0b12',\n+             }\n+           }\n+         }\n+       }\n+     }\n+   </script>\n+   <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\" />\n+   <style>\n+     @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');\n+     body {\n+       font-family: 'Plus Jakarta Sans', sans-serif;\n+       background-color: #0b0b12;\n+       color: #cdd6f4;\n+     }\n+     .glass-panel {\n+       background: rgba(30, 30, 46, 0.65);\n+       backdrop-filter: blur(16px);\n+       border: 1px solid rgba(255, 255, 255, 0.08);\n+     }\n+     .glass-card {\n+       background: rgba(45, 45, 68, 0.4);\n+       backdrop-filter: blur(8px);\n+       border: 1px solid rgba(255, 255, 255, 0.05);\n+     }\n+     /* Custom Scrollbar */\n+     ::-webkit-scrollbar {\n+       width: 6px;\n+     }\n+     ::-webkit-scrollbar-track {\n+       background: rgba(0, 0, 0, 0.1);\n+     }\n+     ::-webkit-scrollbar-thumb {\n+       background: rgba(255, 255, 255, 0.15);\n+       border-radius: 3px;\n+     }\n+     ::-webkit-scrollbar-thumb:hover {\n+       background: rgba(255, 255, 255, 0.3);\n+     }\n+   </style>\n+ </head>\n+ <body class=\"h-screen flex overflow-hidden\">\n+ \n+   <!-- Sidebar Container -->\n+   <aside class=\"w-80 border-r border-white/10 glass-panel flex flex-col justify-between hidden md:flex z-20\">\n+     <div>\n+       <!-- App Header -->\n+       <div class=\"p-5 flex items-center justify-between border-b border-white/10\">\n+         <div class=\"flex items-center space-x-3\">\n+           <div class=\"w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 to-purple-600 flex items-center justify-center text-white shadow-lg shadow-indigo-500/20\">\n+             <i class=\"fa-solid me-0 fa-brain text-xl\"></i>\n+           </div>\n+           <div>\n+             <h1 class=\"font-bold text-white tracking-wide\">RAG AI Assistant</h1>\n+             <span class=\"text-xs text-indigo-400 font-medium\">Grounding Engine v1.0</span>\n+           </div>\n+         </div>\n+       </div>\n+ \n+       <!-- Action Buttons -->\n+       <div class=\"p-4 space-y-2\">\n+         <button id=\"newChatBtn\" class=\"w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl font-medium transition flex items-center justify-center space-x-2 shadow-lg shadow-indigo-600/30\">\n+           <i class=\"fa-solid fa-plus text-sm\"></i>\n+           <span>New Conversation</span>\n+         </button>\n+         <button id=\"openIngestModalBtn\" class=\"w-full py-2.5 px-4 bg-white/5 hover:bg-white/10 text-white border border-white/10 rounded-xl font-medium transition flex items-center justify-center space-x-2\">\n+           <i class=\"fa-solid fa-file-arrow-up text-indigo-400\"></i>\n+           <span>Ingest Knowledge Doc</span>\n+         </button>\n+       </div>\n+ \n+       <!-- Conversation History List -->\n+       <div class=\"px-4 py-2\">\n+         <h2 class=\"text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2\">Recent Sessions</h2>\n+         <div id=\"conversationList\" class=\"space-y-1 overflow-y-auto max-h-[380px] pr-1\">\n+           <!-- Dynamic conversation items -->\n+           <div class=\"p-3 rounded-xl bg-white/5 border border-white/10 text-white text-sm cursor-pointer flex items-center justify-between\">\n+             <div class=\"flex items-center space-x-2 truncate\">\n+               <i class=\"fa-regular fa-message text-indigo-400\"></i>\n+               <span class=\"truncate\">General Assistant Session</span>\n+             </div>\n+           </div>\n+         </div>\n+       </div>\n+     </div>\n+ \n+     <!-- Indexed Knowledge Section -->\n+     <div class=\"p-4 border-t border-white/10 bg-black/20\">\n+       <div class=\"flex items-center justify-between mb-2\">\n+         <span class=\"text-xs font-semibold text-gray-400 uppercase tracking-wider\">Indexed Documents</span>\n+         <span id=\"docCountBadge\" class=\"text-xs bg-indigo-500/20 text-indigo-300 px-2 py-0.5 rounded-full font-mono\">0</span>\n+       </div>\n+       <div id=\"documentMiniList\" class=\"space-y-1.5 max-h-32 overflow-y-auto pr-1\">\n+         <p class=\"text-xs text-gray-500 italic\">No documents indexed yet.</p>\n+       </div>\n+     </div>\n+   </aside>\n+ \n+   <!-- Main Chat & Workspace Area -->\n+   <main class=\"flex-1 flex flex-col h-full bg-gradient-to-b from-surface-900 to-surface-950\">\n+     \n+     <!-- Top Header Bar -->\n+     <header class=\"h-16 border-b border-white/10 px-6 flex items-center justify-between glass-panel z-10\">\n+       <div class=\"flex items-center space-x-3\">\n+         <button id=\"mobileToggle\" class=\"md:hidden text-gray-400 hover:text-white\">\n+           <i class=\"fa-solid fa-bars text-lg\"></i>\n+         </button>\n+         <div>\n+           <h2 id=\"activeSessionTitle\" class=\"font-semibold text-white\">General Assistant Session</h2>\n+           <div class=\"flex items-center space-x-2 text-xs text-gray-400\">\n+             <span class=\"inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse\"></span>\n+             <span>Vector Grounding Active</span>\n+           </div>\n+         </div>\n+       </div>\n+ \n+       <div class=\"flex items-center space-x-3\">\n+         <span class=\"text-xs bg-white/5 border border-white/10 text-gray-300 px-3 py-1.5 rounded-lg flex items-center space-x-2\">\n+           <i class=\"fa-solid fa-bolt text-amber-400\"></i>\n+           <span>Hybrid Vector Search</span>\n+         </span>\n+       </div>\n+     </header>\n+ \n+     <!-- Chat Messages Scroll Container -->\n+     <div id=\"chatMessages\" class=\"flex-1 overflow-y-auto p-6 space-y-6\">\n+       \n+       <!-- Welcome Card -->\n+       <div class=\"max-w-2xl mx-auto glass-card p-6 rounded-2xl text-center border border-white/10 my-8\">\n+         <div class=\"w-12 h-12 rounded-2xl bg-indigo-500/20 text-indigo-400 flex items-center justify-center mx-auto mb-4 text-2xl\">\n+           <i class=\"fa-solid fa-brain\"></i>\n+         </div>\n+         <h3 class=\"text-xl font-bold text-white mb-2\">Welcome to RAG AI Assistant</h3>\n+         <p class=\"text-sm text-gray-400 mb-4\">\n+           Ask questions grounded on your uploaded documents. Vector similarity search will retrieve relevant passages to form context-backed responses.\n+         </p>\n+         <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-3 text-left\">\n+           <div class=\"p-3 bg-white/5 rounded-xl border border-white/5 text-xs hover:border-indigo-500/30 cursor-pointer\" onclick=\"setInput('What is Retrieval-Augmented Generation?')\">\n+             <span class=\"font-semibold text-white block mb-1\">🔍 Explain RAG</span>\n+             <span class=\"text-gray-400\">Overview of vector search and grounding.</span>\n+           </div>\n+           <div class=\"p-3 bg-white/5 rounded-xl border border-white/5 text-xs hover:border-indigo-500/30 cursor-pointer\" onclick=\"setInput('How does document chunking work?')\">\n+             <span class=\"font-semibold text-white block mb-1\">📄 Text Chunking</span>\n+             <span class=\"text-gray-400\">Overlapping token windows strategy.</span>\n+           </div>\n+         </div>\n+       </div>\n+ \n+     </div>\n+ \n+     <!-- Citation Sources Drawer / Preview Box -->\n+     <div id=\"sourcesDrawer\" class=\"hidden px-6 py-3 border-t border-white/10 bg-indigo-950/30 border-indigo-500/20\">\n+       <div class=\"flex items-center justify-between mb-2\">\n+         <span class=\"text-xs font-semibold text-indigo-300 flex items-center space-x-1.5\">\n+           <i class=\"fa-solid fa-quote-left\"></i>\n+           <span>Retrieved Context Sources</span>\n+         </span>\n+         <button onclick=\"toggleSourcesDrawer()\" class=\"text-xs text-gray-400 hover:text-white\">&times; Close</button>\n+       </div>\n+       <div id=\"sourcesContainer\" class=\"flex space-x-3 overflow-x-auto pb-1\">\n+         <!-- Dynamic source pills -->\n+       </div>\n+     </div>\n+ \n+     <!-- Input Bar -->\n+     <div class=\"p-4 border-t border-white/10 glass-panel\">\n+       <form id=\"chatForm\" class=\"max-w-4xl mx-auto flex items-center space-x-3\">\n+         <div class=\"relative flex-1\">\n+           <input\n+             type=\"text\"\n+             id=\"queryInput\"\n+             placeholder=\"Type your message or query your indexed knowledge base...\"\n+             class=\"w-full bg-white/5 border border-white/10 focus:border-indigo-500 rounded-2xl py-3.5 pl-4 pr-12 text-sm text-white placeholder-gray-500 focus:outline-none transition\"\n+             autocomplete=\"off\"\n+             required\n... (truncated)",
